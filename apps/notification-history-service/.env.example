# notification-history-service — app-specific settings (shared ones live in the root .env)
PORT=3008
DATABASE_URL=postgres://medflow:secret@localhost:5433/notification_db
# Action history: one Kafka fetch (and one INSERT transaction) per partition holds at most this many bytes
HISTORY_BATCH_MAX_BYTES=1048576
# Same for in-app notifications
NOTIFICATION_BATCH_MAX_BYTES=1048576
# Notifications of older events (e.g. replayed after an outage) are stored but not pushed live
NOTIFICATION_PUSH_MAX_AGE_SECONDS=600
# Emails: Kafka batch size, BullMQ worker parallelism and SMTP rate limit
EMAIL_BATCH_MAX_BYTES=1048576
EMAIL_CONCURRENCY=5
EMAIL_RATE_LIMIT_PER_SECOND=10
# SMTP (dev: Mailpit, web inbox on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedFlow <no-reply@medflow.az>"
