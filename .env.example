# ─── Shared settings for every app (local development) ────────────────────────
# App-specific values (PORT, DATABASE_URL) live in apps/<app>/.env.
# Copy all templates once with: npm run env:init
NODE_ENV=development

# Shared secret between the gateway and the services (min 32 chars)
INTERNAL_API_KEY=dev-internal-key-change-me-0123456789abcdef

FRONTEND_URL=http://localhost:5173

# Access JWT — signed by auth-service, verified by the gateway (min 32 chars)
JWT_ACCESS_SECRET=dev-jwt-access-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# Proxy / internal-call targets
AUTH_SERVICE_URL=http://localhost:3001
STAFF_SERVICE_URL=http://localhost:3002
PATIENT_SERVICE_URL=http://localhost:3003
APPOINTMENT_SERVICE_URL=http://localhost:3004
RECORD_SERVICE_URL=http://localhost:3005
BILLING_SERVICE_URL=http://localhost:3006
FILE_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008

# ─── Docker infrastructure (read by docker compose) ──────────────────────────
POSTGRES_USER=medflow
POSTGRES_PASSWORD=secret
# Host port — 5433 because a local PostgreSQL may already use 5432
POSTGRES_HOST_PORT=5433
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
